{#-
  Geo Model Blockbench Format Template
  =====================================
  Produces the Blockbench-compatible .geo.json for visual preview/editing.

  Expected variables:
    - identifier: str              Model identifier (e.g. "model.kirin")
    - texture_width: int           Texture atlas width in pixels
    - texture_height: int          Texture atlas height in pixels
    - visible_bounds_width: float  Blockbench viewport bounds width (default: 3)
    - visible_bounds_height: float Blockbench viewport bounds height (default: 4.5)
    - visible_bounds_offset: list  Blockbench viewport offset (default: [0, 1.5, 0])
    - bones: list                  List of bone dicts from _prepare_bones_for_template()
    - indent: int                  JSON indentation level (default: 2)

  Format differences from game format:
    - Top-level wrapper: "minecraft:geometry" array (not "model" object)
    - "description" sub-object with identifier, texture_width, texture_height,
      visible_bounds_width, visible_bounds_height, visible_bounds_offset
    - UV format is the SAME as game format
    - All bone data (pivot, rotation, cubes, parent) is identical
-#}
{
  "format_version": "1.12.0",
  "minecraft:geometry": [
    {
      "description": {
        "identifier": {{ identifier | tojson }},
        "texture_width": {{ texture_width | tojson }},
        "texture_height": {{ texture_height | tojson }},
        "visible_bounds_width": {{ visible_bounds_width | tojson }},
        "visible_bounds_height": {{ visible_bounds_height | tojson }},
        "visible_bounds_offset": {{ visible_bounds_offset | tojson }}
      },
      "bones": [
{% for bone in bones %}
        {
          "name": {{ bone.name | tojson }},
          "pivot": {{ bone.pivot | tojson }}
{% if bone.has_parent %},
          "parent": {{ bone.parent | tojson }}
{% endif %}
{% if bone.has_rotation %},
          "rotation": {{ bone.rotation | tojson }}
{% endif %}
{% if bone.has_cubes %},
          "cubes": [
{% for cube in bone.cubes %}
            {
              "origin": {{ cube.origin | tojson }},
              "size": {{ cube.size | tojson }},
              "uv": {
{% for face_name in ['north', 'south', 'west', 'east', 'up', 'down'] %}
                "{{ face_name }}": {{ cube.uv[face_name] | tojson }}{{ "," if not loop.last else "" }}
{% endfor %}
              }
{% if cube.has_mirror %},
              "mirror": true
{% endif %}
{% if cube.has_inflate %},
              "inflate": {{ cube.inflate | tojson }}
{% endif %}
            }{{ "," if not loop.last else "" }}
{% endfor %}
          ]
{% endif %}
        }{{ "," if not loop.last else "" }}
{% endfor %}
      ]
    }
  ]
}
