{#-
  GeckoLib Java Model Class Template
  ====================================
  Produces a GeckoLib 4.x compatible Java model class.

  Expected variables:
    - package_name: str           Java package (e.g. "com.example.srparasites.client.model")
    - class_name: str             Java class name (e.g. "KirinGeoModel")
    - entity_class: str           Entity class name (e.g. "KirinEntity")
    - entity_package: str         Entity class package
    - mod_id: str                 Mod identifier (e.g. "srparasites")
    - model_path: str             Model resource path (e.g. "geo/entity/kirin.geo.json")
    - texture_path: str           Texture resource path (e.g. "textures/entity/monster/kirin.png")
    - animation_path: str         Animation resource path (e.g. "animations/entity/kirin.animation.json")
    - has_code_animations: bool   Whether code animations are needed (Class A-2)
    - code_animation_methods: str Java code for codeAnimations override (optional)
    - bone_names: list[str]       List of bone names for reference constants
    - head_bones: list[str]       List of head/neck bone names for head tracking (optional)
    - has_head_tracking: bool     Whether head tracking is enabled
-#}
package {{ package_name }};

import net.minecraft.resources.ResourceLocation;
import software.bernie.geckolib.model.GeoModel;
{% if has_code_animations %}
import software.bernie.geckolib.animation.AnimatableManager;
import software.bernie.geckolib.animation.AnimationController;
import software.bernie.geckolib.animation.AnimationState;
import software.bernie.geckolib.animation.RawAnimation;
{% endif %}
{% if has_head_tracking %}
import software.bernie.geckolib.cache.object.GeoBone;
{% endif %}
import {{ entity_package }}.{{ entity_class }};

public class {{ class_name }} extends GeoModel<{{ entity_class }}> {

{% if bone_names %}
    // Bone name constants (for code animation reference)
{% for bone_name in bone_names %}
    public static final String BONE_{{ bone_name | upper }} = "{{ bone_name }}";
{% endfor %}

{% endif %}
    @Override
    public ResourceLocation getModelResource({{ entity_class }} animatable) {
        return new ResourceLocation("{{ mod_id }}", "{{ model_path }}");
    }

    @Override
    public ResourceLocation getTextureResource({{ entity_class }} animatable) {
        return new ResourceLocation("{{ mod_id }}", "{{ texture_path }}");
    }

    @Override
    public ResourceLocation getAnimationResource({{ entity_class }} animatable) {
        return new ResourceLocation("{{ mod_id }}", "{{ animation_path }}");
    }
{% if has_code_animations %}

    /**
     * Class A-2: Movement-driven animation code.
     * These animations depend on runtime entity state (limbSwing, limbSwingAmount)
     * and cannot be expressed in .animation.json format.
     */
    @Override
    public void codeAnimations({{ entity_class }} animatable, AnimatableManager<{{ entity_class }}> manager) {
{{ code_animation_methods | indent(8) }}
    }
{% endif %}
{% if has_head_tracking %}

    /**
     * Head tracking: Rotate head/neck bones to follow the nearest player.
     * Supports multi-bone head chains (head -> neck -> upper_neck).
     */
    @Override
    public void codeAnimations({{ entity_class }} animatable, AnimatableManager<{{ entity_class }}> manager) {
{% if not has_code_animations %}
{% for head_bone in head_bones %}
        GeoBone {{ head_bone }}Bone = this.getAnimationProcessor().getBone(BONE_{{ head_bone | upper }});
{% endfor %}

        // Get look angles from entity
        float yaw = animatable.getYRot() * ((float) Math.PI / 180f);
        float pitch = animatable.getXRot() * ((float) Math.PI / 180f);

        // Calculate head rotation limits
        float maxYaw = (float) Math.toRadians(75.0);
        float maxPitch = (float) Math.toRadians(45.0);
        float headYaw = Math.max(-maxYaw, Math.min(maxYaw, yaw));
        float headPitch = Math.max(-maxPitch, Math.min(maxPitch, pitch));

{% if head_bones | length > 1 %}
        // Multi-bone head chain: distribute rotation across chain
        float boneCount = {{ head_bones | length }}.0f;
{% for head_bone in head_bones %}
        if ({{ head_bone }}Bone != null) {
            {{ head_bone }}Bone.setRotationY(headYaw / boneCount);
            {{ head_bone }}Bone.setRotationX(-headPitch / boneCount);
        }
{% endfor %}
{% else %}
        // Single head bone
        if ({{ head_bones[0] }}Bone != null) {
            {{ head_bones[0] }}Bone.setRotationY(headYaw);
            {{ head_bones[0] }}Bone.setRotationX(-headPitch);
        }
{% endif %}
{% endif %}
    }
{% endif %}
}
