// Auto-generated by MC1122 -> GeckoLib Animation Converter
// Class A-2: Movement-driven animation (limbSwing dependent)
// Place this code in your GeoModel's codeAnimations method
//
// IMPORTANT: These animations depend on runtime entity state
// and CANNOT be expressed in .animation.json format.
// They must remain as Java code in the GeoModel subclass.

// Get animation parameters from entity
float limbSwing = animatable.limbSwing;
float limbSwingAmount = animatable.limbSwingAmount;
float ageInTicks = animatable.ageInTicks;
float headYaw = animatable.getYRot() * ((float) Math.PI / 180f);
float headPitch = animatable.getXRot() * ((float) Math.PI / 180f);

{% for bone_anim in bone_animations %}
// Bone: {{ bone_anim.bone_name }} ({{ bone_anim.bone_var }})
GeoBone {{ bone_anim.bone_var }}Bone = this.getAnimationProcessor().getBone("{{ bone_anim.bone_name }}");
if ({{ bone_anim.bone_var }}Bone != null) {
{% if bone_anim.rotation_x %}
    {{ bone_anim.bone_var }}Bone.setRotationX((float)({{ bone_anim.rotation_x }}));
{% endif %}
{% if bone_anim.rotation_y %}
    {{ bone_anim.bone_var }}Bone.setRotationY((float)({{ bone_anim.rotation_y }}));
{% endif %}
{% if bone_anim.rotation_z %}
    {{ bone_anim.bone_var }}Bone.setRotationZ((float)({{ bone_anim.rotation_z }}));
{% endif %}
{% if bone_anim.position_x %}
    {{ bone_anim.bone_var }}Bone.setOffsetX((float)({{ bone_anim.position_x }}));
{% endif %}
{% if bone_anim.position_y %}
    {{ bone_anim.bone_var }}Bone.setOffsetY((float)({{ bone_anim.position_y }}));
{% endif %}
