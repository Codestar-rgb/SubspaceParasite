{% for layer in animation_layers | sort(attribute='priority', reverse=True) %}
//     controllers.add({{ layer.controller_name }});
{% endfor %}
// }
{% endif %}
{% if overlay_controllers %}

// ========================================================================
// Overlay Controllers (with transitionNested support)
// ========================================================================
{% for overlay in overlay_controllers %}

// Overlay: {{ overlay.name }}
AnimationController<{{ entity_class }}> {{ overlay.name }} =
    new AnimationController<{{ entity_class }}>(this, "{{ overlay.name }}", {{ overlay.transition_length }}f, event -> {
        {{ entity_class }} animatable = event.getAnimatable();

{% for state in overlay.states | sort(attribute='priority', reverse=True) %}
        // State: {{ state.name }} (priority {{ state.priority }})
        if ({{ state.condition }}) {
{% if state.is_looping %}
            event.getController().setAnimation(
                RawAnimation.begin().then("{{ state.animation_name }}", Animation.LoopType.LOOP)
            );
{% else %}
            event.getController().setAnimation(
                RawAnimation.begin().then("{{ state.animation_name }}", Animation.LoopType.PLAY_ONCE)
            );
{% endif %}
            return PlayState.CONTINUE;
        }

{% endfor %}
        return PlayState.STOP;
    }){% if overlay.transition_nested %}.transitionNested({{ overlay.transition_length }}f){% endif %};

{% endfor %}
